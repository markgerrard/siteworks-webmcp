          },
          {
            "functionName": "siteworks.describe_import_products",
            "arguments": {},
            "optional": true,
            "mockOutput": {
              "contract": {
                "schema_version": 1,
                "formats": ["json", "csv", "md"],
                "fields": ["name", "category", "price", "sku", "description"],
                "notes": "Always dry_run:true first; commit with dry_run:false and a fresh idempotency_key."
              }
            }
          },
          {
            "functionName": "siteworks.import_products",
