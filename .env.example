# SiteWorks WebMCP demo — committed defaults. Nothing here is a secret.
APP_NAME="Camino Bakehouse (WebMCP demo)"
APP_ENV=local
APP_DEBUG=false
APP_KEY=
APP_URL=http://app.localhost:8090

# Two hostnames on one port: the storefront on localhost, the client portal on app.localhost.
APP_PRIMARY_DOMAIN=app.localhost
APP_CUSTOMER_DOMAIN=app.localhost
APP_AGENT_DOMAIN=agents.localhost
APP_EDITOR_PREVIEW_DOMAIN=app.localhost
DEMO_SITE_HOST=localhost

SURFACE=all
LOG_CHANNEL=stack
LOG_LEVEL=info
FORCE_HTTPS=false
SITE_USE_VERSIONED_RENDERER=true

DEMO_MODE=1
DB_CONNECTION=sqlite
DB_DATABASE=/var/www/html/storage/demo/demo.sqlite
QUEUE_CONNECTION=sync
CACHE_STORE=file
SESSION_DRIVER=file
FILESYSTEM_DISK=local
MEDIA_DISK=public
MEDIA_PRIVATE_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log

# Demo portal login (seeded by `php artisan demo:seed`; change if you deploy publicly)
DEMO_USER_EMAIL=demo@camino.example
DEMO_USER_PASSWORD=webmcp-demo

# Feature flags the WebMCP layer reads (tools exposed to the seeded CLIENT user on the portal;
# approval flow off for the demo: write tools apply directly to the draft)
EDITOR_AGENT_TOOLS=true
EDITOR_AGENT_TOOLS_ROLES=staff,client
EDITOR_AGENT_TOOLS_CLIENT_PORTAL=true
EDITOR_AGENT_APPROVAL=false
EDITOR_OPERATIONS=true
TEXTURE_AUTO_DEFAULTS=false

# Optional payment integration.
# STRIPE_SECRET=
# STRIPE_WEBHOOK_SECRET=

# Optional preview-domain brand overrides.
# CLOUDFLARE_A_ZONE_ID=
# CLOUDFLARE_A_APEX=
# CLOUDFLARE_A_SUBDOMAIN=
# CLOUDFLARE_A_FALLBACK=
# CLOUDFLARE_B_ZONE_ID=
# CLOUDFLARE_B_APEX=
# CLOUDFLARE_B_SUBDOMAIN=
# CLOUDFLARE_B_FALLBACK=
